{
  "name": "yoavshlomov-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static website for Yoav Shlomov — jazz guitarist & producer. Hosted on Cloudflare Pages.",
  "scripts": {
    "dev": "wrangler pages dev . --ip 127.0.0.1 --port 8788 --compatibility-date=2026-08-06",
