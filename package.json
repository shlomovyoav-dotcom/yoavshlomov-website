    "test": "python3 dns/test_generate_blocklist.py && python3 functions/test_private_paths.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlomovyoav-dotcom/yoavshlomov-website.git"
  },
  "license": "ISC",
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
